StatusOr<std::string> generate_python_bindings_module(const CompiledProtocol& protocol,
                                                      const PythonBindingsOptions& options) {
  const std::string module_name = options.module_name.empty() ? sanitize_namespace_name(protocol.name())
                                                              : sanitize_namespace_name(options.module_name);

  std::string out;
  append_line(&out, 0,
              R"("""Generated by Universal Protocol Runtime for module ')" + module_name +
                  R"('. Do not edit by hand.""")");
  append_line(&out);
  append_line(&out, 0, "from __future__ import annotations");
  append_line(&out);
  append_line(&out, 0, "from dataclasses import dataclass, field as _field");
  append_line(&out, 0, "from typing import Any, List, Optional");
  append_line(&out);
  append_line(&out, 0, "from universal_protocol_runtime import Codec as _Codec");
  append_line(&out, 0, "from universal_protocol_runtime import metadata as _md");
  append_line(&out, 0, "import " + python_native_module_name(protocol, options) + " as _native");
  append_line(&out);
  append_line(&out, 0, "PROTOCOL_NAME = \"" + escape_python_string(protocol.name()) + "\"");
  append_line(&out, 0, "PROTOCOL_FINGERPRINT = " + std::to_string(protocol.fingerprint()));
  append_line(&out);

  append_line(&out, 0, "PROTOCOL = _md.Protocol(");
  append_line(&out, 1, "name=\"" + escape_python_string(protocol.name()) + "\",");
  append_line(&out, 1, "fingerprint=" + std::to_string(protocol.fingerprint()) + ",");
  append_line(&out, 1, "structs=(");
  for (const CompiledMessage& struct_layout : protocol.structs()) {
    append_python_layout_literal(&out, struct_layout, false, 2);
  }
  append_line(&out, 1, "),");
  append_line(&out, 1, "messages=(");
  for (const CompiledMessage& message : protocol.messages()) {
    append_python_layout_literal(&out, message, true, 2);
  }
  append_line(&out, 1, "),");
  append_line(&out, 0, ")");
  append_line(&out);
  append_line(&out, 0, "class _NativeCodec(_Codec):");
  append_line(&out, 1, "def encode(self, name: str, values: object) -> bytes:");
  append_line(&out, 2, "self._layout(name, for_encode=True)");
  append_line(&out, 2, "return _native.encode(name, values)");
  append_line(&out, 1, "def decode(self, name: str, frame: object, *, zero_copy: bool = False) -> dict[str, object]:");
  append_line(&out, 2, "self._layout(name)");
  append_line(&out, 2, "return _native.decode(name, frame)");
  append_line(&out, 1, "def decode_sequence(self, name: str, frame: object, *, zero_copy: bool = False) -> List[dict[str, object]]:");
  append_line(&out, 2, "self._layout(name)");
  append_line(&out, 2, "return _native.decode_sequence(name, frame)");
  append_line(&out);
  append_line(&out, 0, "CODEC = _NativeCodec(PROTOCOL)");
  append_line(&out);

  for (const CompiledMessage& struct_layout : protocol.structs()) {
    append_python_dataclass(&out, protocol, struct_layout, 0);
    append_line(&out);
  }
  for (const CompiledMessage& message : protocol.messages()) {
    append_python_dataclass(&out, protocol, message, 0);
    append_line(&out);
  }

  for (const CompiledMessage& struct_layout : protocol.structs()) {
    append_line(&out,
                0,
                "CODEC.register_dataclass(\"" + escape_python_string(sanitize_type_name(struct_layout.name())) +
                    "\", " + sanitize_type_name(struct_layout.name()) + ")");
  }
  for (const CompiledMessage& message : protocol.messages()) {
    append_line(&out,
                0,
                "CODEC.register_dataclass(\"" + escape_python_string(sanitize_type_name(message.name())) + "\", " +
                    sanitize_type_name(message.name()) + ")");
  }
  append_line(&out);

  append_line(&out, 0, "STRUCTS = (");
  for (const CompiledMessage& struct_layout : protocol.structs()) {
    append_line(&out, 1, sanitize_type_name(struct_layout.name()) + ",");
  }
  append_line(&out, 0, ")");
  append_line(&out, 0, "MESSAGES = (");
  for (const CompiledMessage& message : protocol.messages()) {
    append_line(&out, 1, sanitize_type_name(message.name()) + ",");
  }
  append_line(&out, 0, ")");

  return out;
}

StatusOr<std::string> generate_python_native_extension_module(const CompiledProtocol& protocol,
                                                             const PythonBindingsOptions& options) {
  const std::string module_name = python_native_module_name(protocol, options);
  const std::string protocol_namespace = sanitize_namespace_name(protocol.name());
  const Status validation = validate_python_native_protocol(protocol);
  if (!validation.ok()) {
    return validation;
  }

  std::string out;
  append_line(&out, 0, "// Generated by Universal Protocol Runtime. Do not edit by hand.");
  append_line(&out, 0, "#include <algorithm>");
  append_line(&out, 0, "#include <cstddef>");
  append_line(&out, 0, "#include <cstdint>");
  append_line(&out, 0, "#include <deque>");
  append_line(&out, 0, "#include <limits>");
  append_line(&out, 0, "#include <optional>");
  append_line(&out, 0, "#include <string>");
  append_line(&out, 0, "#include <string_view>");
  append_line(&out, 0, "#include <vector>");
  append_line(&out);
  append_line(&out, 0, "#include <pybind11/pybind11.h>");
  append_line(&out, 0, "#include <pybind11/stl.h>");
  append_line(&out);
  append_line(&out, 0, "#include \"" + escape_cpp_string(python_native_header_include(protocol, options)) + "\"");
  append_line(&out);
  append_line(&out, 0, "namespace py = pybind11;");
  append_line(&out, 0, "namespace gen = upr_generated::" + protocol_namespace + ";");
  append_line(&out);
  append_line(&out, 0, "namespace {");
  append_line(&out);
  append_line(&out, 0, "constexpr std::size_t kInitialEncodeCapacity = 256U;");
  append_line(&out, 0, "constexpr std::size_t kMaxEncodeCapacity = 64U * 1024U * 1024U;");
  append_line(&out);
  append_line(&out, 0, "py::object none() { return py::none(); }");
  append_line(&out);
  append_line(&out, 0, "py::object get_field(py::object source, const char* name) {");
  append_line(&out, 1, "if (source.is_none()) {");
  append_line(&out, 2, "return none();");
  append_line(&out, 1, "}");
  append_line(&out, 1, "if (py::isinstance<py::dict>(source)) {");
  append_line(&out, 2, "py::dict mapping = source.cast<py::dict>();");
  append_line(&out, 2, "py::str key(name);");
  append_line(&out, 2, "if (mapping.contains(key)) {");
  append_line(&out, 3, "return py::reinterpret_borrow<py::object>(mapping[key]);");
  append_line(&out, 2, "}");
  append_line(&out, 2, "return none();");
  append_line(&out, 1, "}");
  append_line(&out, 1, "if (py::hasattr(source, name)) {");
  append_line(&out, 2, "return source.attr(name);");
  append_line(&out, 1, "}");
  append_line(&out, 1, "return none();");
  append_line(&out, 0, "}");
  append_line(&out);
  append_line(&out, 0, "const char* decode_status_attribute(universal_protocol_runtime::DecodeStatus status) {");
  append_line(&out, 1, "switch (status) {");
  append_line(&out, 2, "case universal_protocol_runtime::DecodeStatus::kOk:");
  append_line(&out, 3, "return \"OK\";");
  append_line(&out, 2, "case universal_protocol_runtime::DecodeStatus::kMessageNotFound:");
  append_line(&out, 3, "return \"MESSAGE_NOT_FOUND\";");
  append_line(&out, 2, "case universal_protocol_runtime::DecodeStatus::kSchemaMismatch:");
  append_line(&out, 3, "return \"SCHEMA_MISMATCH\";");
  append_line(&out, 2, "case universal_protocol_runtime::DecodeStatus::kInvalidData:");
  append_line(&out, 3, "return \"INVALID_DATA\";");
  append_line(&out, 2, "case universal_protocol_runtime::DecodeStatus::kChecksumMismatch:");
  append_line(&out, 3, "return \"CHECKSUM_MISMATCH\";");
  append_line(&out, 2, "case universal_protocol_runtime::DecodeStatus::kFieldLimitExceeded:");
  append_line(&out, 3, "return \"FIELD_LIMIT_EXCEEDED\";");
  append_line(&out, 1, "}");
  append_line(&out, 1, "return \"INVALID_DATA\";");
  append_line(&out, 0, "}");
  append_line(&out);
  append_line(&out, 0, "void set_decode_error(const universal_protocol_runtime::DecodeError& error) {");
  append_line(&out, 1, "py::object upr = py::module_::import(\"universal_protocol_runtime\");");
  append_line(&out, 1, "py::object status = upr.attr(\"DecodeStatus\").attr(decode_status_attribute(error.status));");
  append_line(&out, 1, "py::object exc = upr.attr(\"DecodeError\")(status, std::string(error.field_name), error.byte_offset);");
  append_line(&out, 1, "PyErr_SetObject(upr.attr(\"DecodeError\").ptr(), exc.ptr());");
  append_line(&out, 0, "}");
  append_line(&out);
  append_line(&out, 0, "void set_decode_status(universal_protocol_runtime::DecodeStatus status, std::size_t offset = 0U) {");
  append_line(&out, 1, "universal_protocol_runtime::DecodeError error{status, std::string_view(), offset};");
  append_line(&out, 1, "set_decode_error(error);");
  append_line(&out, 0, "}");
  append_line(&out);
  append_line(&out, 0, "void set_encode_error(std::string_view message) {");
  append_line(&out, 1, "py::object upr = py::module_::import(\"universal_protocol_runtime\");");
  append_line(&out, 1, "py::object exc = upr.attr(\"EncodeError\")(std::string(message));");
  append_line(&out, 1, "PyErr_SetObject(upr.attr(\"EncodeError\").ptr(), exc.ptr());");
  append_line(&out, 0, "}");
  append_line(&out);
  append_line(&out,
              0,
              "std::optional<universal_protocol_runtime::ByteSpan> buffer_span(PyObject* object, Py_buffer* view) {");
  append_line(&out, 1, "if (PyObject_GetBuffer(object, view, PyBUF_CONTIG_RO) != 0) {");
  append_line(&out, 2, "set_decode_status(universal_protocol_runtime::DecodeStatus::kInvalidData);");
  append_line(&out, 2, "return std::nullopt;");
  append_line(&out, 1, "}");
  append_line(&out, 1, "if (view->itemsize != 1) {");
  append_line(&out, 2, "PyBuffer_Release(view);");
  append_line(&out, 2, "set_decode_status(universal_protocol_runtime::DecodeStatus::kInvalidData);");
  append_line(&out, 2, "return std::nullopt;");
  append_line(&out, 1, "}");
  append_line(&out,
              1,
              "return universal_protocol_runtime::ByteSpan(reinterpret_cast<const std::byte*>(view->buf), "
              "static_cast<std::size_t>(view->len));");
  append_line(&out, 0, "}");
  append_line(&out);
  for (const size_t struct_id : topological_struct_order(protocol)) {
    const CompiledMessage* struct_layout = protocol.struct_by_id(struct_id);
    if (struct_layout == nullptr) {
      continue;
    }
    append_line(&out,
                0,
                native_value_type(protocol, *struct_layout) + " " + native_from_py_name(*struct_layout) +
                    "(py::object source, std::deque<std::string>& storage);");
    append_line(&out,
                0,
                "py::dict " + native_to_py_name(*struct_layout) + "(const " +
                    native_value_type(protocol, *struct_layout) + "& value);");
  }
  for (const CompiledMessage& message : protocol.messages()) {
    append_line(&out,
                0,
                native_value_type(protocol, message) + " " + native_from_py_name(message) +
                    "(py::object source, std::deque<std::string>& storage);");
    append_line(&out,
                0,
                "py::dict " + native_to_py_name(message) + "(const " + native_value_type(protocol, message) +
                    "& value);");
  }
  append_line(&out);
  for (const size_t struct_id : topological_struct_order(protocol)) {
    const CompiledMessage* struct_layout = protocol.struct_by_id(struct_id);
    if (struct_layout == nullptr) {
      continue;
    }
    append_python_native_from_py_function(&out, protocol, *struct_layout);
    append_python_native_to_py_function(&out, protocol, *struct_layout);
  }
  for (const CompiledMessage& message : protocol.messages()) {
    append_python_native_from_py_function(&out, protocol, message);
    append_python_native_to_py_function(&out, protocol, message);
  }
  append_line(&out, 0, "template <typename Layout>");
  append_line(&out, 0, "py::object encode_layout(const typename Layout::Value& value) {");
  append_line(&out, 1, "std::size_t capacity = kInitialEncodeCapacity;");
  append_line(&out, 1, "while (capacity <= kMaxEncodeCapacity) {");
  append_line(&out, 2, "std::vector<std::byte> frame(capacity);");
  append_line(&out, 2, "std::size_t written = 0U;");
  append_line(&out,
              2,
              "const universal_protocol_runtime::EncodeStatus status = Layout::encode_value_direct("
              "value, universal_protocol_runtime::MutableByteSpan(frame.data(), frame.size()), &written);");
  append_line(&out, 2, "if (status == universal_protocol_runtime::EncodeStatus::kOk) {");
  append_line(&out, 3, "return py::bytes(reinterpret_cast<const char*>(frame.data()), written);");
  append_line(&out, 2, "}");
  append_line(&out, 2, "if (status != universal_protocol_runtime::EncodeStatus::kBufferTooSmall) {");
  append_line(&out, 3, "set_encode_error(universal_protocol_runtime::to_string(status));");
  append_line(&out, 3, "return py::object();");
  append_line(&out, 2, "}");
  append_line(&out, 2, "capacity *= 2U;");
  append_line(&out, 1, "}");
  append_line(&out, 1, "set_encode_error(\"encoded frame exceeds generated native capacity limit\");");
  append_line(&out, 1, "return py::object();");
  append_line(&out, 0, "}");
  append_line(&out);
  append_line(&out, 0, "template <typename Layout, typename Value, typename Converter>");
  append_line(&out, 0, "py::object decode_layout(PyObject* buffer, Converter value_to_py) {");
  append_line(&out, 1, "Py_buffer frame_view{};");
  append_line(&out, 1, "const auto frame_result = buffer_span(buffer, &frame_view);");
  append_line(&out, 1, "if (!frame_result.has_value()) {");
  append_line(&out, 2, "return py::object();");
  append_line(&out, 1, "}");
  append_line(&out, 1, "universal_protocol_runtime::ByteSpan frame = *frame_result;");
  append_line(&out, 1, "Value value{};");
  append_line(&out, 1, "std::size_t consumed = 0U;");
  append_line(&out, 1, "universal_protocol_runtime::DecodeError error{};");
  append_line(&out,
              1,
              "const universal_protocol_runtime::DecodeStatus status = Layout::decode_value_direct(frame, &value, "
              "&consumed, &error);");
  append_line(&out, 1, "if (status != universal_protocol_runtime::DecodeStatus::kOk) {");
  append_line(&out, 2, "PyBuffer_Release(&frame_view);");
  append_line(&out, 2, "set_decode_error(error);");
  append_line(&out, 2, "return py::object();");
  append_line(&out, 1, "}");
  append_line(&out, 1, "if (consumed != frame.size()) {");
  append_line(&out, 2, "PyBuffer_Release(&frame_view);");
  append_line(&out, 2, "set_decode_status(universal_protocol_runtime::DecodeStatus::kSchemaMismatch, consumed);");
  append_line(&out, 2, "return py::object();");
  append_line(&out, 1, "}");
  append_line(&out, 1, "py::object result = value_to_py(value);");
  append_line(&out, 1, "PyBuffer_Release(&frame_view);");
  append_line(&out, 1, "return result;");
  append_line(&out, 0, "}");
  append_line(&out);
  append_line(&out, 0, "template <typename Layout, typename Value, typename Converter>");
  append_line(&out, 0, "py::object decode_sequence_layout(PyObject* buffer, Converter value_to_py) {");
  append_line(&out, 1, "Py_buffer frame_view{};");
  append_line(&out, 1, "const auto frame_result = buffer_span(buffer, &frame_view);");
  append_line(&out, 1, "if (!frame_result.has_value()) {");
  append_line(&out, 2, "return py::object();");
  append_line(&out, 1, "}");
  append_line(&out, 1, "universal_protocol_runtime::ByteSpan frame = *frame_result;");
  append_line(&out, 1, "py::list items;");
  append_line(&out, 1, "std::size_t offset = 0U;");
  append_line(&out, 1, "while (offset < frame.size()) {");
  append_line(&out, 2, "Value value{};");
  append_line(&out, 2, "std::size_t consumed = 0U;");
  append_line(&out, 2, "universal_protocol_runtime::DecodeError error{};");
  append_line(&out,
              2,
              "const universal_protocol_runtime::DecodeStatus status = Layout::decode_value_direct(frame.subspan(offset), "
              "&value, &consumed, &error);");
  append_line(&out, 2, "if (status != universal_protocol_runtime::DecodeStatus::kOk) {");
  append_line(&out, 3, "error.byte_offset += offset;");
  append_line(&out, 3, "PyBuffer_Release(&frame_view);");
  append_line(&out, 3, "set_decode_error(error);");
  append_line(&out, 3, "return py::object();");
  append_line(&out, 2, "}");
  append_line(&out, 2, "if (consumed == 0U) {");
  append_line(&out, 3, "PyBuffer_Release(&frame_view);");
  append_line(&out, 3, "set_decode_status(universal_protocol_runtime::DecodeStatus::kSchemaMismatch, offset);");
  append_line(&out, 3, "return py::object();");
  append_line(&out, 2, "}");
  append_line(&out, 2, "offset += consumed;");
  append_line(&out, 2, "items.append(value_to_py(value));");
  append_line(&out, 1, "}");
  append_line(&out, 1, "PyBuffer_Release(&frame_view);");
  append_line(&out, 1, "return items;");
  append_line(&out, 0, "}");
  append_line(&out);
  append_line(&out, 0, "py::object encode(std::string_view name, py::object values) {");
  for (const CompiledMessage& struct_layout : protocol.structs()) {
    append_python_native_dispatch_branch(&out, protocol, struct_layout, "encode", 1);
  }
  for (const CompiledMessage& message : protocol.messages()) {
    append_python_native_dispatch_branch(&out, protocol, message, "encode", 1);
  }
  append_line(&out, 1, "set_encode_error(\"layout not found\");");
  append_line(&out, 1, "return py::object();");
  append_line(&out, 0, "}");
  append_line(&out);
  append_line(&out, 0, "py::object decode(std::string_view name, PyObject* frame) {");
  for (const CompiledMessage& struct_layout : protocol.structs()) {
    append_python_native_dispatch_branch(&out, protocol, struct_layout, "decode", 1);
  }
  for (const CompiledMessage& message : protocol.messages()) {
    append_python_native_dispatch_branch(&out, protocol, message, "decode", 1);
  }
  append_line(&out, 1, "set_decode_status(universal_protocol_runtime::DecodeStatus::kMessageNotFound);");
  append_line(&out, 1, "return py::object();");
  append_line(&out, 0, "}");
  append_line(&out);
  append_line(&out, 0, "py::object decode_sequence(std::string_view name, PyObject* frame) {");
  for (const CompiledMessage& struct_layout : protocol.structs()) {
    append_python_native_dispatch_branch(&out, protocol, struct_layout, "decode_sequence", 1);
  }
  for (const CompiledMessage& message : protocol.messages()) {
    append_python_native_dispatch_branch(&out, protocol, message, "decode_sequence", 1);
  }
  append_line(&out, 1, "set_decode_status(universal_protocol_runtime::DecodeStatus::kMessageNotFound);");
  append_line(&out, 1, "return py::object();");
  append_line(&out, 0, "}");
  append_line(&out);
  append_line(&out, 0, "PyObject* encode_py(PyObject*, PyObject* args) {");
  append_line(&out, 1, "const char* name = nullptr;");
  append_line(&out, 1, "PyObject* values = nullptr;");
  append_line(&out, 1, "if (PyArg_ParseTuple(args, \"sO\", &name, &values) == 0) {");
  append_line(&out, 2, "return nullptr;");
  append_line(&out, 1, "}");
  append_line(&out, 1, "py::object result = encode(name, py::reinterpret_borrow<py::object>(values));");
  append_line(&out, 1, "if (result.ptr() == nullptr) {");
  append_line(&out, 2, "return nullptr;");
  append_line(&out, 1, "}");
  append_line(&out, 1, "return result.release().ptr();");
  append_line(&out, 0, "}");
  append_line(&out);
  append_line(&out, 0, "PyObject* decode_py(PyObject*, PyObject* args) {");
  append_line(&out, 1, "const char* name = nullptr;");
  append_line(&out, 1, "PyObject* frame = nullptr;");
  append_line(&out, 1, "if (PyArg_ParseTuple(args, \"sO\", &name, &frame) == 0) {");
  append_line(&out, 2, "return nullptr;");
  append_line(&out, 1, "}");
  append_line(&out, 1, "py::object result = decode(name, frame);");
  append_line(&out, 1, "if (result.ptr() == nullptr) {");
  append_line(&out, 2, "return nullptr;");
  append_line(&out, 1, "}");
  append_line(&out, 1, "return result.release().ptr();");
  append_line(&out, 0, "}");
  append_line(&out);
  append_line(&out, 0, "PyObject* decode_sequence_py(PyObject*, PyObject* args) {");
  append_line(&out, 1, "const char* name = nullptr;");
  append_line(&out, 1, "PyObject* frame = nullptr;");
  append_line(&out, 1, "if (PyArg_ParseTuple(args, \"sO\", &name, &frame) == 0) {");
  append_line(&out, 2, "return nullptr;");
  append_line(&out, 1, "}");
  append_line(&out, 1, "py::object result = decode_sequence(name, frame);");
  append_line(&out, 1, "if (result.ptr() == nullptr) {");
  append_line(&out, 2, "return nullptr;");
  append_line(&out, 1, "}");
  append_line(&out, 1, "return result.release().ptr();");
  append_line(&out, 0, "}");
  append_line(&out);
  append_line(&out, 0, "PyMethodDef kMethods[] = {");
  append_line(&out, 1, R"({"encode", encode_py, METH_VARARGS, nullptr},)");
  append_line(&out, 1, R"({"decode", decode_py, METH_VARARGS, nullptr},)");
  append_line(&out, 1, R"({"decode_sequence", decode_sequence_py, METH_VARARGS, nullptr},)");
  append_line(&out, 1, "{nullptr, nullptr, 0, nullptr},");
  append_line(&out, 0, "};");
  append_line(&out);
  append_line(&out, 0, "}  // namespace");
  append_line(&out);
  append_line(&out, 0, "PYBIND11_MODULE(" + module_name + ", m) {");
  append_line(&out, 1, "m.doc() = \"Generated Universal Protocol Runtime native codec\";");
  append_line(&out, 1, "if (PyModule_AddFunctions(m.ptr(), kMethods) != 0) {");
  append_line(&out, 2, "return;");
  append_line(&out, 1, "}");
  append_line(&out, 0, "}");

  return out;
}
