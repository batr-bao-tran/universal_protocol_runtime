{
  "name": "universal-protocol-runtime",
  "version": "0.1.0",
  "description": "Dependency-free TypeScript/JavaScript runtime for Universal Protocol Runtime (UPR) schemas. Byte-compatible with the C++ and Python runtimes.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "upr",
    "protocol",
    "codec",
    "serialization",
    "binary"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "monocart-coverage-reports": "^2.12.12",
    "typescript": "^5.5.0"
  }
}
