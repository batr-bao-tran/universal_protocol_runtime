build --cxxopt=-std=c++20
build --host_cxxopt=-std=c++20

build --action_env=PATH
build --host_action_env=PATH

build --linkopt=-fuse-ld=lld
build --host_linkopt=-fuse-ld=lld

build:linux --linkopt=-fuse-ld=lld
build:linux --host_linkopt=-fuse-ld=lld

build --cxxopt=-Wall --cxxopt=-Wextra
build --copt=-Wno-error=unused-parameter
build --cxxopt=-Wno-error=unused-parameter
build --host_cxxopt=-Wno-error=unused-parameter

# Suppress warnings from third-party code.
build --per_file_copt=external/protobuf+/.*@-w
build --per_file_copt=external/abseil-cpp+/.*@-w
build --host_per_file_copt=external/protobuf+/.*@-w
build --host_per_file_copt=external/abseil-cpp+/.*@-w

build:sanitize --compilation_mode=dbg
build:sanitize --strip=never
build:sanitize --repo_env=CC=clang
build:sanitize --repo_env=CXX=clang++
build:sanitize --copt=-fsanitize=address,undefined
build:sanitize --cxxopt=-fsanitize=address,undefined
build:sanitize --linkopt=-fsanitize=address,undefined
build:sanitize --linkopt=-fsanitize-link-c++-runtime
build:sanitize --copt=-fno-omit-frame-pointer
build:sanitize --cxxopt=-fno-omit-frame-pointer
build:sanitize --copt=-O1
build:sanitize --cxxopt=-O1
test:sanitize --test_env=ASAN_OPTIONS=detect_leaks=1:abort_on_error=1:strict_init_order=1:detect_stack_use_after_return=1
test:sanitize --test_env=UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1

test --test_output=errors
test --test_summary=short
